<Window
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:av="http://schemas.microsoft.com/expression/blend/2008" xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" mc:Ignorable="av" x:Class="ApkInstaller.Feature_classes.FileExplorerWindow"
        Title="Device File Explorer" Height="600" Width="800">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Toolbar -->
        <ToolBarTray Grid.Row="0">
            <ToolBar>
                <Button x:Name="HomeButton" Content="🏠 Home" Click="HomeButton_Click"/>
                <Button x:Name="BackButton" Content="↩ Back" Click="BackButton_Click"/>
                <Separator/>
                <Button x:Name="DownloadButton" Content="📥 Download" Click="DownloadButton_Click" IsEnabled="False"/>
                <Button x:Name="DeleteButton" Content="🗑 Delete" Click="DeleteButton_Click" IsEnabled="False"/>
                <Button x:Name="NewFolderButton" Content="📁 New Folder" Click="NewFolderButton_Click"/>
            </ToolBar>
        </ToolBarTray>

        <!-- File List -->
        <ListView x:Name="FileListView" Grid.Row="1" Margin="10" 
            SelectionMode="Single"
            MouseDoubleClick="FileListView_MouseDoubleClick"
            SelectionChanged="FileListView_SelectionChanged">
            <ListView.ItemContainerStyle>
                <Style TargetType="ListViewItem">
                    <Setter Property="IsEnabled" Value="{Binding IsSelectable}"/>
                </Style>
            </ListView.ItemContainerStyle>
            <ListView.ItemTemplate>
                <DataTemplate>
                    <StackPanel Orientation="Horizontal">
                        <TextBlock FontSize="20">
                            <TextBlock.Style>
                                <Style TargetType="{x:Type TextBlock}">
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsDirectory}" Value="True">
                                            <Setter Property="Text" Value="📁"/>
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding IsDirectory}" Value="False">
                                            <Setter Property="Text" Value="📄"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                        <TextBlock Text="{Binding Name}" Padding="5,0"/>
                    </StackPanel>
                </DataTemplate>
            </ListView.ItemTemplate>
        </ListView>

        <!-- Status Bar -->
        <StatusBar Grid.Row="2" Background="LightGray" >
            <StatusBarItem>
                <TextBlock x:Name="StatusTextBlock" Padding="10,0" Foreground="Black"/>
            </StatusBarItem>
        </StatusBar>
    </Grid>
</Window>